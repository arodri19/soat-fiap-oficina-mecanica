{
  "name": "oficina-backend",
  "version": "1.0.0",
  "description": "API backend para oficina mecânica com autenticação, ordens de serviço e gerenciamento de clientes, veículos, serviços e peças.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "node prisma/seed.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:ci": "jest --coverage --runInBand --passWithNoTests",
    "test:watch": "jest --watchAll"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "oficina",
    "backend",
    "express",
    "prisma",
    "postgres"
  ],
  "author": "Equipe Oficina",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.12.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "istanbul": "^0.4.5",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "nyc": "^18.0.0",
    "prisma": "^5.12.0",
    "supertest": "^6.3.4"
  }
}
