# Copie este arquivo para terraform.tfvars e ajuste os valores.
# terraform.tfvars é ignorado pelo git (ver .gitignore).

project_name = "oficina-mecanica"
aws_region   = "us-east-1"
environment  = "dev"

# ── EKS ─────────────────────────────────────────────────────────
cluster_version    = "1.30"
node_instance_type = "t3.medium"  # 2 vCPU, 4 GiB — suficiente para dev
node_desired_size  = 2
node_min_size      = 2
node_max_size      = 5

# ── RDS ─────────────────────────────────────────────────────────
db_name              = "oficina"
db_username          = "postgres"
db_password          = "TrocaPorSenhaSegura123!"   # OBRIGATÓRIO substituir
db_instance_class    = "db.t3.micro"               # free-tier eligible
db_allocated_storage = 20
