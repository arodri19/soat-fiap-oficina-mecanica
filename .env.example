DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oficina
JWT_SECRET=sua_chave_jwt_aqui
PORT=4001

# Observabilidade (New Relic) — deixe NEW_RELIC_LICENSE_KEY em branco para
# desabilitar o agente localmente (fica automaticamente desligado em testes)
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=oficina-mecanica-api

# NEW_RELIC_ACCOUNT_ID/NEW_RELIC_API_KEY (User API Key, NRAK-...) — diferente da
# LICENSE_KEY acima (que só ingere dados): usadas por
# POST /api/metrics/status-duration-averages/recompute para CONSULTAR a New Relic
# e recalcular a média real de tempo por status. Deixe em branco para desabilitar
# esse endpoint localmente (ele responde 400 sem travar o resto da aplicação).
NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_API_KEY=

LOG_LEVEL=info
