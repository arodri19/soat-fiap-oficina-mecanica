# ──────────────────────────────────────────────────────────────────────────────
# Configuração dos Secrets e Variables no GitHub
# Settings → Secrets and variables → Actions
#
# Este arquivo é APENAS uma referência — nunca commitar com valores reais.
# Adicionar cada item abaixo individualmente na interface do GitHub.
# ──────────────────────────────────────────────────────────────────────────────

# ── Repository Secrets (criptografados, invisíveis em logs) ──────────────────

AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Senha do banco de dados (usada pelo Terraform e pelo K8s Secret)
DB_PASSWORD=SenhaSegura123!

# Chave JWT da aplicação
JWT_SECRET=sua-chave-jwt-super-secreta-aqui

# ── Repository Variables (visíveis em logs, não-sensíveis) ───────────────────

AWS_REGION=us-east-1
EKS_CLUSTER_NAME=oficina-mecanica-dev

# Bucket S3 para armazenar o Terraform state (deve existir antes do primeiro apply)
# Criar com: aws s3 mb s3://oficina-terraform-state --region us-east-1
TF_STATE_BUCKET=oficina-terraform-state

# Tabela DynamoDB para lock do Terraform state (previne conflitos concorrentes)
# Criar com: aws dynamodb create-table --table-name oficina-terraform-lock \
#            --attribute-definitions AttributeName=LockID,AttributeType=S \
#            --key-schema AttributeName=LockID,KeyType=HASH \
#            --billing-mode PAY_PER_REQUEST --region us-east-1
TF_STATE_LOCK_TABLE=oficina-terraform-lock
