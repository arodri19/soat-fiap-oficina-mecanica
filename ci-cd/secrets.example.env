# ──────────────────────────────────────────────────────────────────────────────
# Configuração dos Secrets e Variables no GitHub
# Settings → Secrets and variables → Actions
#
# Este arquivo é APENAS uma referência — nunca commitar com valores reais.
# Adicionar cada item abaixo individualmente na interface do GitHub.
# ──────────────────────────────────────────────────────────────────────────────

# ── Repository Secrets (criptografados, invisíveis em logs) ──────────────────

AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Usuário do Docker Hub (repositório público arodri19/oficina-mecanica-app)
DOCKERHUB_USERNAME=arodri19

# Access Token do Docker Hub (Account Settings → Security → New Access Token)
DOCKERHUB_TOKEN=dckr_pat_exemplo

# Senha do banco de dados (usada pelo K8s Secret; o RDS em si é provisionado
# e tem sua senha definida pelo repositório soat-fiap-oficina-mecanica-infra-data)
DB_PASSWORD=SenhaSegura123!

# Chave JWT da aplicação
JWT_SECRET=sua-chave-jwt-super-secreta-aqui

# ── Repository Variables (visíveis em logs, não-sensíveis) ───────────────────

AWS_REGION=us-east-1
EKS_CLUSTER_NAME=oficina-mecanica-dev

# Endpoint do RDS (host:porta), copiado do output db_endpoint do repositório
# soat-fiap-oficina-mecanica-infra-data após o apply lá
RDS_ENDPOINT=oficina-mecanica-dev-postgres.xxxxxxxxxx.us-east-1.rds.amazonaws.com:5432

# Nota: TF_STATE_BUCKET e TF_STATE_LOCK_TABLE não são mais usados neste
# repositório — o provisionamento de infraestrutura (VPC, EKS, RDS) migrou
# para os repositórios soat-fiap-oficina-mecanica-infra-kube e
# soat-fiap-oficina-mecanica-infra-data.
